From 9bd485a9d90b189fcc9adfb542c53d3290bed9bc Mon Sep 17 00:00:00 2001
From: Di Wu <diwux@google.com>
Date: Fri, 8 Aug 2025 03:56:56 +0000
Subject: [PATCH] Use absl::Overload() instead of absl::Overload{}

Change-Id: Ia22bdde5849efa1e2515e3474b4e1613eecde789
patch-name: backward-compatibility-2100-Use-absl-Overload-function.patch
---
 base/trace_event/traced_value.cc | 10 ++++------
 third_party/ipcz/src/ipcz/box.cc | 14 +++++++-------
 third_party/ipcz/src/ipcz/box.h  |  8 ++++----
 3 files changed, 15 insertions(+), 17 deletions(-)

diff --git a/base/trace_event/traced_value.cc b/base/trace_event/traced_value.cc
index 0d05420..381b395 100644
--- a/base/trace_event/traced_value.cc
+++ b/base/trace_event/traced_value.cc
@@ -698,7 +698,7 @@ TracedValue::ValueHolder::ValueHolder(TracedValue::ValueHolder&&) = default;
 TracedValue::ValueHolder::~ValueHolder() = default;
 
 void TracedValue::ValueHolder::WriteToValue(TracedValue* value) const {
-  std::visit(absl::Overload{
+  std::visit(absl::Overload(
                  [value](int v) { value->AppendInteger(v); },
                  [value](double v) { value->AppendDouble(v); },
                  [value](bool v) { value->AppendBoolean(v); },
@@ -714,15 +714,14 @@ void TracedValue::ValueHolder::WriteToValue(TracedValue* value) const {
                    value->BeginDictionary();
                    v.WriteToValue(value);
                    value->EndDictionary();
-                 },
-             },
+                 }),
              kept_value_);
 }
 
 void TracedValue::ValueHolder::WriteToValue(const char* name,
                                             TracedValue* value) const {
   std::visit(
-      absl::Overload{
+      absl::Overload(
           [name, value](int v) { value->SetInteger(name, v); },
           [name, value](double v) { value->SetDouble(name, v); },
           [name, value](bool v) { value->SetBoolean(name, v); },
@@ -738,8 +737,7 @@ void TracedValue::ValueHolder::WriteToValue(const char* name,
             value->BeginDictionary(name);
             v.WriteToValue(value);
             value->EndDictionary();
-          },
-      },
+          }),
       kept_value_);
 }
 
diff --git a/third_party/ipcz/src/ipcz/box.cc b/third_party/ipcz/src/ipcz/box.cc
index 0d936aa..7415acd 100644
--- a/third_party/ipcz/src/ipcz/box.cc
+++ b/third_party/ipcz/src/ipcz/box.cc
@@ -36,7 +36,7 @@ IpczResult Box::Close() {
 
 bool Box::CanSendFrom(Router& sender) {
   return std::visit(
-      absl::Overload{
+      absl::Overload(
           [](const Empty&) { return false; },
           [](const DriverObject& object) {
             return object.is_valid() && object.IsSerializable();
@@ -49,15 +49,15 @@ bool Box::CanSendFrom(Router& sender) {
               }
             }
             return true;
-          },
-      },
+          }
+      ),
       contents_);
 }
 
 IpczResult Box::ExtractContents(ExtractMode mode, IpczBoxContents& contents) {
   const bool peek = (mode == kPeek);
   const IpczResult result = std::visit(
-      absl::Overload{
+      absl::Overload(
           [](const Empty& empty) { return IPCZ_RESULT_INVALID_ARGUMENT; },
           [&contents, peek](DriverObject& object) {
             contents.type = IPCZ_BOX_TYPE_DRIVER_OBJECT;
@@ -79,8 +79,8 @@ IpczResult Box::ExtractContents(ExtractMode mode, IpczBoxContents& contents) {
                 peek ? wrapper->handle()
                      : ipcz::APIObject::ReleaseAsHandle(std::move(wrapper));
             return IPCZ_RESULT_OK;
-          },
-      },
+          }
+      ),
       contents_);
 
   if (!peek) {
@@ -90,4 +90,4 @@ IpczResult Box::ExtractContents(ExtractMode mode, IpczBoxContents& contents) {
   return result;
 }
 
-}  // namespace ipcz
+}  // namespace ipcz
\ No newline at end of file
diff --git a/third_party/ipcz/src/ipcz/box.h b/third_party/ipcz/src/ipcz/box.h
index 69a9ce6..a5c6625 100644
--- a/third_party/ipcz/src/ipcz/box.h
+++ b/third_party/ipcz/src/ipcz/box.h
@@ -41,12 +41,12 @@ class Box : public APIObjectImpl<Box, APIObject::kBox> {
 
   Type type() const {
     return std::visit(
-        absl::Overload{
+        absl::Overload(
             [](const Empty&) { return Type::kEmpty; },
             [](const DriverObject&) { return Type::kDriverObject; },
             [](const ApplicationObject&) { return Type::kApplicationObject; },
-            [](const Ref<ParcelWrapper>&) { return Type::kSubparcel; },
-        },
+            [](const Ref<ParcelWrapper>&) { return Type::kSubparcel; }
+        ),
         contents_);
   }
 
@@ -81,4 +81,4 @@ class Box : public APIObjectImpl<Box, APIObject::kBox> {
 
 }  // namespace ipcz
 
-#endif  // IPCZ_SRC_IPCZ_BOX_
+#endif  // IPCZ_SRC_IPCZ_BOX_
\ No newline at end of file
