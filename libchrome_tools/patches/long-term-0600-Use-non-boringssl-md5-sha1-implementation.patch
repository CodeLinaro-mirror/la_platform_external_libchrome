 base/hash/md5_nacl.cc          | 297 +++++++++++++++++++++++++++++++++
 base/hash/md5_nacl.h           |  25 +++
 base/hash/sha1.h               |   6 +-
 base/hash/sha1_nacl.cc         | 203 ++++++++++++++++++++++
 base/hash/sha1_nacl.h          |  40 +++++
 base/metrics/metrics_hashes.cc |  39 +++--
 7 files changed, 591 insertions(+), 30 deletions(-)
 create mode 100644 base/hash/md5_nacl.cc
 create mode 100644 base/hash/md5_nacl.h
 create mode 100644 base/hash/sha1_nacl.cc
 create mode 100644 base/hash/sha1_nacl.h

