-  = default;
+                                  std::initializer_list<U> il,
+                                  Args&&... args) noexcept
+      : data_(kErrTag, il, std::forward<Args>(args)...) {}
 
   constexpr ExpectedImpl& operator=(const ExpectedImpl& rhs) noexcept {
-    if (this != &rhs) {
-      switch (rhs.state_) {
-        case State::kValue:
-          emplace_value(rhs.storage_.value);
-          return *this;
-        case State::kError:
-          emplace_error(rhs.storage_.error);
-          return *this;
