 base/base64.h                |  7 ----
 base/base64_encode_fuzzer.cc | 23 ++----------
 base/base64_unittest.cc      | 36 +++++-------------
 base/base64url.cc            | 24 ------------
 base/base64url.h             |  9 -----
 base/features.cc             |  3 --
 base/features.h              |  2 -
 base/simdutf_shim.cc         | 20 ----------
 base/simdutf_shim.h          | 28 --------------
 10 files changed, 29 insertions(+), 194 deletions(-)
