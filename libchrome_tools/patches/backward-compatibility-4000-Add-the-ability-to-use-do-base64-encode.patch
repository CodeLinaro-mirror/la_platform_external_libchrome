 namespace base {
 
-class Base64Test : public testing::TestWithParam<bool> {
- public:
-  Base64Test() = default;
-  Base64Test(const Base64Test&) = delete;
-  Base64Test& operator=(const Base64Test&) = delete;
-  ~Base64Test() override = default;
-
-  void SetUp() override {
-    feature_list_.InitWithFeatureState(features::kSimdutfBase64Encode,
-                                       GetParam());
-  }
-
- private:
-  base::test::ScopedFeatureList feature_list_;
-};
-
-TEST_P(Base64Test, Basic) {
+TEST(Base64Test, Basic) {
   const std::string kText = "hello world";
   const std::string kBase64Text = "aGVsbG8gd29ybGQ=";
 
+  std::string decoded;
+  bool ok;
+
   std::string encoded = Base64Encode(kText);
   EXPECT_EQ(kBase64Text, encoded);
 
-  std::string decoded;
-  bool ok = Base64Decode(encoded, &decoded);
+  ok = Base64Decode(encoded, &decoded);
   EXPECT_TRUE(ok);
   EXPECT_EQ(kText, decoded);
 }
 
-TEST_P(Base64Test, ForgivingAndStrictDecode) {
+TEST(Base64Test, ForgivingAndStrictDecode) {
   struct {
     const char* in;
 
@@ -128,7 +112,7 @@ TEST_P(Base64Test, ForgivingAndStrictDecode) {
   }
 }
 
-TEST_P(Base64Test, Binary) {
+TEST(Base64Test, Binary) {
   const uint8_t kData[] = {0x00, 0x01, 0xFE, 0xFF};
 
   std::string binary_encoded = Base64Encode(kData);
@@ -149,7 +133,7 @@ TEST_P(Base64Test, Binary) {
   EXPECT_EQ(encoded_with_prefix, "PREFIX" + binary_encoded);
 }
 
-TEST_P(Base64Test, InPlace) {
+TEST(Base64Test, InPlace) {
   const std::string kText = "hello world";
   const std::string kBase64Text = "aGVsbG8gd29ybGQ=";
 
@@ -161,7 +145,7 @@ TEST_P(Base64Test, InPlace) {
   EXPECT_EQ(text, kText);
 }
 
-TEST_P(Base64Test, Overflow) {
+TEST(Base64Test, Overflow) {
   // `Base64Encode` makes the input larger, which means inputs whose base64
   // output overflows `size_t`. Actually allocating a span of this size will
   // likely fail, but we test it with a fake span and assume a correct
@@ -183,6 +167,4 @@ TEST_P(Base64Test, Overflow) {
   EXPECT_TRUE(modp_b64_encode_data_len(max_len).IsValid());
 }
 
-INSTANTIATE_TEST_SUITE_P(All, Base64Test, testing::Bool());
-
 }  // namespace base
diff --git a/base/base64url.cc b/base/base64url.cc
index 3f6354e5fd..0926076352 100644
--- a/base/base64url.cc
+++ b/base/base64url.cc
@@ -131,30 +131,6 @@ void Base64UrlEncode(std::string_view input,
   Base64UrlEncode(base::as_byte_span(input), policy, output);
 }
 
-void Base64UrlEncodeEarlyStartup(span<const uint8_t> input,
-                                 Base64UrlEncodePolicy policy,
-                                 std::string* output) {
-  *output = Base64EncodeEarlyStartup(input);
-
-  ReplaceChars(*output, "+", "-", output);
-  ReplaceChars(*output, "/", "_", output);
-
-  switch (policy) {
-    case Base64UrlEncodePolicy::INCLUDE_PADDING:
-      // The padding included in |*output| will not be amended.
-      break;
-    case Base64UrlEncodePolicy::OMIT_PADDING:
-      // The padding included in |*output| will be removed.
-      const size_t last_non_padding_pos =
-          output->find_last_not_of(kPaddingChar);
-      if (last_non_padding_pos != std::string::npos) {
-        output->resize(last_non_padding_pos + 1);
-      }
-
-      break;
-  }
-}
-
 bool Base64UrlDecode(std::string_view input,
                      Base64UrlDecodePolicy policy,
                      std::string* output) {
