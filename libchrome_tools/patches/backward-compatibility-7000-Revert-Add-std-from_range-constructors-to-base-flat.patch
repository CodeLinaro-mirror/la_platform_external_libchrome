+TEST(FlatTree, SortedUniqueRangeConstructor) {
   {
     IntPair input_vals[] = {{1, 1}, {2, 1}, {3, 1}};
     auto span = base::span(input_vals);
@@ -466,30 +440,6 @@ TEST(FlatTree, SortedUniqueIteratorConstructor) {
   }
 }
 
