-TEST(FlatTree, IteratorConstructor) {
+TEST(FlatTree, RangeConstructor) {
   {
     IntPair input_vals[] = {{1, 1}, {1, 2}, {2, 1}, {2, 2}, {1, 3},
                             {2, 3}, {3, 1}, {3, 2}, {3, 3}};
@@ -355,30 +353,6 @@ TEST(FlatTree, IteratorConstructor) {
