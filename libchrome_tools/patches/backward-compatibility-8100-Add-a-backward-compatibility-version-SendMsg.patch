From 2d1faa6fd5292752eb59cc78e17294271b2cfa2f Mon Sep 17 00:00:00 2001
From: Ryo Hashimoto <hashimoto@chromium.org>
Date: Thu, 5 Feb 2026 16:00:26 +0900
Subject: [PATCH] Add a backward compatibility version SendMsg()

Change-Id: I039701237a28b64d3462a3c1d643e4d94721633e
---
 base/posix/unix_domain_socket.h | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/base/posix/unix_domain_socket.h b/base/posix/unix_domain_socket.h
index c91e5877a2..613bd20ffb 100644
--- a/base/posix/unix_domain_socket.h
+++ b/base/posix/unix_domain_socket.h
@@ -42,6 +42,13 @@ class BASE_EXPORT UnixDomainSocket {
                       span<const uint8_t> msg,
                       const std::vector<int>& fds);
 
+  static bool SendMsg(int fd,
+                      const void* msg,
+                      size_t length,
+                      const std::vector<int>& fds) {
+    return SendMsg(fd, UNSAFE_BUFFERS(base::span(reinterpret_cast<const uint8_t*>(msg), length)), fds);
+  }
+
   // Use recvmsg to read a message and an array of file descriptors. Returns
   // -1 on failure. Note: will read, at most, |kMaxFileDescriptors| descriptors.
   // TODO(crbug.com/40284755): implement spanified version.
