From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Di Wu <diwux@google.com>
Date: Fri, 01 May 2026 00:00:00 +0000
Subject: [PATCH] Restore RandInt(int min, int max) for backward
 compatibility

Change-Id: I0000000000000000000000000000000000000000
---
 base/rand_util.cc | 4 ++++
 base/rand_util.h  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/base/rand_util.cc b/base/rand_util.cc
--- a/base/rand_util.cc
+++ b/base/rand_util.cc
@@ -41,6 +41,10 @@ uint64_t RandUint64() {
   return number;
 }
 
+int RandInt(int min, int max) {
+  return RandIntInclusive(min, max);
+}
+
 int RandIntInclusive(int min, int max) {
   DCHECK_LE(min, max);
 
diff --git a/base/rand_util.h b/base/rand_util.h
--- a/base/rand_util.h
+++ b/base/rand_util.h
@@ -53,6 +53,10 @@ namespace test {
 // Returns a random number in range [0, UINT64_MAX]. Thread-safe.
 BASE_EXPORT uint64_t RandUint64();
 
+// Returns a random number between min and max (inclusive). Thread-safe.
+// Alias for RandIntInclusive for backward compatibility.
+BASE_EXPORT int RandInt(int min, int max);
+
 // Returns a random number between min and max (inclusive). Thread-safe.
 //
 // Returns a random number between min and max (inclusive). Thread-safe.
-- 
2.43.0