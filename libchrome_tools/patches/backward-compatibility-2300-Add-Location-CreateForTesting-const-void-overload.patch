From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Byron Lee <byronlee@google.com>
Date: Fri, 2 Oct 2026 05:47:00 +0000
Subject: [PATCH] Add Location::CreateForTesting const void* overload

Upstream commit 15b4bed18d66cf1a6f4c15648cb0646ccbd8ae33
(crrev.com/c/8404568, r1707665) changed base::Location::CreateForTesting
to take uintptr_t program_counter instead of const void*. Add a
backward-compatibility overload accepting const void* for existing
ChromeOS callers (e.g. libbrillo).

BUG=b:568594060
TEST=sudo emerge libchrome

patch-name: backward-compatibility-2300-Add-Location-CreateForTesting-const-void-overload.patch
---
 base/location.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/base/location.h b/base/location.h
index fa17473..ebe7c49 100644
--- a/base/location.h
+++ b/base/location.h
@@ -32,6 +32,14 @@ class BASE_EXPORT Location {
     return Location(function_name, file_name, line_number, program_counter);
   }
 
+  static Location CreateForTesting(const char* function_name,
+                                   const char* file_name,
+                                   int line_number,
+                                   const void* program_counter) {
+    return CreateForTesting(function_name, file_name, line_number,
+                            reinterpret_cast<uintptr_t>(program_counter));
+  }
+
   // Comparator for testing. The program counter should uniquely
   // identify a location.
   friend bool operator==(const Location& lhs, const Location& rhs) {
-- 
2.47.0
