 // implemented as aliases of `base::internal::LRUCacheBase`, defined at the
-// bottom of this file. `base::HashingLRUCache` and `base::HashingLRUCacheSet`
-// are defined in `base/containers/hashing_lru_cache.h`.
+// bottom of this file.
 //
